[Unit]
Description=DGX Spark LLM Runner dashboard
After=network-online.target docker.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
Environment=LLMRUNNER_CONFIG=__INSTALL_DIR__/llms.json
ExecStart=__INSTALL_DIR__/.venv/bin/uvicorn llmrunner.api:app --host 0.0.0.0 --port 8501
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
